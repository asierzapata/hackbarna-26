{
  "name": "kan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/room-server",
    "packages/protocol",
    "packages/nodes"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @kan/desktop",
    "build": "npm run build -w @kan/desktop",
    "preview": "npm run preview -w @kan/desktop",
    "tauri": "npm run tauri -w @kan/desktop --",
    "tauri:drive": "npm run tauri:drive -w @kan/desktop",
    "typecheck": "npm run typecheck -w @kan/desktop && npm run typecheck:backend",
    "server": "tsx apps/room-server/src/main.ts",
    "test:backend": "tsx --test apps/room-server/test/*.test.ts",
    "typecheck:backend": "tsc -p tsconfig.backend.json"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
