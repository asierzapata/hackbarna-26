[Unit]
Description=Poll origin/main for kan deploys

[Timer]
OnBootSec=1min
OnUnitActiveSec=60s
AccuracySec=5s
# Without this a deploy that outlives the interval would queue up runs.
# The flock in the script is the real guard; this keeps the queue clean.
Persistent=false

[Install]
WantedBy=timers.target
